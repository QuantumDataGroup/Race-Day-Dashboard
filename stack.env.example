# Variables to enter in Portainer (Stack > Environment variables). Never commit real values.
MONGODB_URI=mongodb://user:pass@host:27017/dbname
SESSION_SECRET=change-me-long-random-string
# Used only on first boot to create the first admin; manage users in the app afterwards.
# Avoid a '$' in ADMIN_PASSWORD (compose treats it as interpolation).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-8-chars
HOST_PORT=7800
IMAGE_TAG=latest
TZ=Australia/Sydney
# Optional overrides
#RUNNERS_API_URL=
#NEDS_SITE_BASE=
